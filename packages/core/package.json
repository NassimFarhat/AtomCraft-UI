{
  "name": "@atomscraft/core",
  "version": "0.3.0",
  "description": "Framework-agnostic behavior primitives for AtomCraft.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NassimFarhat/AtomCraft-UI.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/NassimFarhat/AtomCraft-UI#readme",
  "bugs": {
    "url": "https://github.com/NassimFarhat/AtomCraft-UI/issues"
  },
  "keywords": [
    "atomcraft",
    "design-system",
    "ui",
    "behavior"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "pack:check": "npm pack --dry-run",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^5.1.1"
  }
}
