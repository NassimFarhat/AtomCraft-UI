{
  "name": "@atomscraft/tokens",
  "version": "0.3.0",
  "description": "Design tokens for AtomCraft: primitives, semantic themes and visual styles.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "tokens.json"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.json": "./tokens.json",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NassimFarhat/AtomCraft-UI.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/NassimFarhat/AtomCraft-UI#readme",
  "bugs": {
    "url": "https://github.com/NassimFarhat/AtomCraft-UI/issues"
  },
  "keywords": [
    "atomcraft",
    "design-tokens",
    "tokens",
    "dtcg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "pack:check": "npm pack --dry-run",
    "test": "vitest run",
    "generate": "tsx scripts/generate-css.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "vitest": "^5.1.1"
  }
}
