{
  "name": "@atomscraft/react",
  "version": "0.2.0",
  "description": "Accessible React components for AtomCraft, built with Atomic Design.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NassimFarhat/AtomCraft-UI.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/NassimFarhat/AtomCraft-UI#readme",
  "bugs": {
    "url": "https://github.com/NassimFarhat/AtomCraft-UI/issues"
  },
  "keywords": [
    "atomcraft",
    "react",
    "design-system",
    "accessible",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "pack:check": "npm pack --dry-run",
    "test": "vitest run"
  },
  "dependencies": {
    "@atomscraft/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.8",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.8",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
