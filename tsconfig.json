{
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "noEmit": true, "allowJs": false },
  "include": [
    "packages/*/src",
    "packages/*/scripts",
    "packages/*/*.config.ts",
    "apps/*/src",
    "apps/*/.storybook/*.ts",
    "apps/*/.storybook/*.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
